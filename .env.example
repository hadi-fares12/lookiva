NODE_ENV=development
PORT=4000
API_PORT=4000
DATABASE_URL=postgresql://lookiva:lookiva@localhost:5432/lookiva?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
PUBLIC_CUSTOMER_WEB_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
MOBILE_API_URL=http://10.0.2.2:4000/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000

# Object storage. Local MinIO is suitable for development; production must use durable object storage.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=lookiva_admin
MINIO_SECRET_KEY=replace-with-a-strong-minio-secret
MEDIA_PUBLIC_BASE_URL=http://localhost:9000

# OTP/SMS
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email. Production supports a generic HTTPS provider adapter.
EMAIL_PROVIDER=console
EMAIL_PROVIDER_BASE_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@lookiva.app

# Push. Production supports a generic HTTPS provider adapter; mobile token registration is required.
PUSH_PROVIDER=console
PUSH_PROVIDER_BASE_URL=
PUSH_API_KEY=

# Maps/public discovery
MAP_PROVIDER=maplibre
MAP_API_KEY=

# Online payments can remain disabled for cash-only deployments. If enabled in production, use a real provider.
ONLINE_PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=disabled
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Optional one-time production bootstrap. Never use the demo seed in production.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
