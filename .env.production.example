NODE_ENV=production
PORT=4000
API_PORT=4000

POSTGRES_DB=lookiva
POSTGRES_USER=lookiva
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://lookiva:REPLACE_DB_PASSWORD@postgres:5432/lookiva?schema=public

REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@redis:6379

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

CORS_ORIGINS=https://app.example.com,https://business.example.com,https://admin.example.com
PUBLIC_CUSTOMER_WEB_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
MOBILE_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://your-map-provider.example/style.json
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.example.com

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-with-a-random-storage-access-key
MINIO_SECRET_KEY=replace-with-a-long-random-storage-secret
MEDIA_PUBLIC_BASE_URL=https://media.example.com

SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

EMAIL_PROVIDER=generic_http
EMAIL_PROVIDER_BASE_URL=https://your-email-gateway.example/send
EMAIL_API_KEY=
EMAIL_FROM=no-reply@example.com

PUSH_PROVIDER=generic_http
PUSH_PROVIDER_BASE_URL=https://your-push-gateway.example/send
PUSH_API_KEY=

MAP_PROVIDER=maplibre
MAP_API_KEY=

ONLINE_PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=disabled
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# First production bootstrap only. Remove these after the first successful production seed.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-16-plus-character-password
