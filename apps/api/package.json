{
    "name": "@lookiva/api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "nest start --watch",
        "build": "pnpm dlx @nestjs/cli@10.4.9 build",
        "start": "node dist/apps/api/src/main.js",
        "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
        "typecheck": "tsc --noEmit",
        "test:unit": "vitest run --config vitest.unit.config.ts",
        "test:int": "vitest run --config vitest.int.config.ts",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate deploy",
        "prisma:seed": "ts-node prisma/seed.ts --mode=dev",
        "prisma:seed:test": "ts-node prisma/seed.ts --mode=test",
        "prisma:seed:prod": "ts-node prisma/seed.ts --mode=prod"
    },
    "dependencies": {
        "@lookiva/api-contracts": "workspace:*",
        "@lookiva/design-tokens": "workspace:*",
        "@lookiva/localization": "workspace:*",
        "@lookiva/shared-config": "workspace:*",
        "@lookiva/shared-types": "workspace:*",
        "@lookiva/shared-validation": "workspace:*",
        "@nestjs/bullmq": "^10.0.0",
        "@nestjs/common": "^10.0.0",
        "@nestjs/config": "^3.0.0",
        "@nestjs/core": "^10.0.0",
        "@nestjs/jwt": "^10.0.0",
        "@nestjs/passport": "^10.0.0",
        "@nestjs/platform-express": "^10.0.0",
        "@nestjs/swagger": "^7.0.0",
        "@nestjs/terminus": "^10.0.0",
        "@nestjs/throttler": "^5.0.0",
        "@prisma/client": "^5.0.0",
        "bcrypt": "^5.1.0",
        "bullmq": "^5.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "cors": "^2.8.5",
        "express": "^5.2.1",
        "helmet": "^7.0.0",
        "ioredis": "^5.0.0",
        "minio": "^7.0.0",
        "multer": "^2.4.0",
        "nestjs-i18n": "^10.0.0",
        "nestjs-pino": "^4.0.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pino-http": "^10.0.0",
        "pino-pretty": "13.1.3",
        "rxjs": "^7.8.2",
        "sharp": "^0.33.0",
        "uuid": "^9.0.0",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@lookiva/eslint-config": "workspace:*",
        "@lookiva/typescript-config": "workspace:*",
        "@nestjs/testing": "^10.0.0",
        "@types/bcrypt": "^5.0.0",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.2.0",
        "@types/node": "^20.0.0",
        "@types/passport-jwt": "^4.0.0",
        "@vitest/coverage-v8": "^1.0.0",
        "prisma": "^5.0.0",
        "supertest": "^6.3.0",
        "ts-node": "^10.9.0",
        "typescript": "^5.3.3",
        "vitest": "^1.0.0"
    }
}
