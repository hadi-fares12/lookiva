model loyalty_ledger {
  id                 String    @id @default(cuid())
  loyalty_account_id String
  transaction_type   String
  points_change      Int
  balance_after      Int
  reference_id       String?
  reference_type     String?
  expires_at         DateTime?
  description        String?
  created_at         DateTime  @default(now())

  loyalty_account loyalty_accounts @relation(fields: [loyalty_account_id], references: [id], onDelete: Cascade)

  @@index([loyalty_account_id])
  @@index([transaction_type])
  @@index([expires_at])
