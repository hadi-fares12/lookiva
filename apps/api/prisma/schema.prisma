  appointment_id  String?
  response_json   Json
  signature_url   String?
  photo_id_url    String?
  signed_at       DateTime
  expires_at      DateTime?
  revoked_at      DateTime?
  ip_address      String?
  user_agent      String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  consent_form consent_forms @relation(fields: [consent_form_id], references: [id], onDelete: Cascade)
  customer     customers     @relation(fields: [customer_id], references: [id])
  appointment  appointments? @relation(fields: [appointment_id], references: [id], onDelete: SetNull)

  @@index([consent_form_id])
  @@index([customer_id])
  @@index([appointment_id])
}

// ============================================================
// SUBSCRIPTIONS, SUPPORT, DISPUTES, MODERATION, AUDIT, ANALYTICS
// ============================================================

model subscriptions {
  id                 String    @id @default(cuid())
  company_id         String
  plan_id            String
  customer_user_id   String?
  status             String    @default("active")
  billing_cycle      String
  price_per_cycle    Float
  currency_code      String
  trial_ends_at      DateTime?
  current_period_end DateTime?
  started_at         DateTime  @default(now())
  cancelled_at       DateTime?
  ends_at            DateTime?
  payment_method_id  String?
  external_reference String?
  metadata           Json?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  company companies          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  plan    subscription_plans @relation(fields: [plan_id], references: [id])

  @@index([company_id])
  @@index([plan_id])
  @@index([status])
}

model subscription_plans {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  description   String?
  price_monthly Float
  price_yearly  Float
  currency_code String
  trial_days    Int      @default(0)
  is_active     Boolean  @default(true)
  tier_level    Int      @default(1)
  sort_order    Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  features      subscription_features[]
  subscriptions subscriptions[]

  @@index([code])
  @@index([is_active])
}

model subscription_features {
  id          String   @id @default(cuid())
  plan_id     String
  feature_key String
  name        String
  value_json  Json?
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())

  plan subscription_plans @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@index([plan_id])
  @@index([feature_key])
}

model commission_rules {
  id                  String    @id @default(cuid())
  company_id          String
  name                String
  description         String?
  professional_id     String?
  service_category_id String?
  service_id          String?
  calculation_type    String
  percent_rate        Float?
  fixed_amount        Float?
  tiered_rates        Json?
  effective_from      DateTime?
  effective_to        DateTime?
  is_active           Boolean   @default(true)
  sort_order          Int       @default(0)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  company     companies     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  commissions commissions[]

  @@index([company_id])
  @@index([professional_id])
  @@index([is_active])
}

model support_tickets {
  id                  String    @id @default(cuid())
  user_id             String
  company_id          String?
  subject             String
  description         String
  priority            String    @default("normal")
  category            String
  status              String    @default("open")
  assigned_to_id      String?
  closed_at           DateTime?
  satisfaction_rating Int?
  tags                String[]  @default([])
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  messages support_messages[]

  @@index([user_id])
  @@index([company_id])
  @@index([status])
  @@index([priority])
  @@index([created_at])
}

model support_messages {
  id               String   @id @default(cuid())
  ticket_id        String
  author_user_id   String
  author_type      String
  body             String
  attachment_ids   String[] @default([])
  is_internal_note Boolean  @default(false)
  created_at       DateTime @default(now())

  ticket support_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@index([created_at])
}

model disputes {
  id                 String    @id @default(cuid())
  company_id         String
  reporter_user_id   String
  disputed_type      String
  disputed_id        String
  payment_id         String?
  appointment_id     String?
  reason             String
  details            String?
  evidence_media_ids String[]  @default([])
  status             String    @default("open")
  disputed_amount    Float?
  currency_code      String?
  resolution         String?
  resolution_amount  Float?
  resolved_by_id     String?
  resolved_at        DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  company companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([reporter_user_id])
  @@index([status])
  @@index([disputed_type, disputed_id])
}

model moderation_reports {
  id                 String    @id @default(cuid())
  reporter_user_id   String
  target_type        String
  target_id          String
  reason_type        String
  details            String?
  evidence_media_ids String[]  @default([])
  status             String    @default("pending")
  reviewed_by_id     String?
  reviewed_at        DateTime?
  action_taken       String?
  action_details     String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  @@index([target_type, target_id])
  @@index([reporter_user_id])
  @@index([status])
  @@index([created_at])
}

model audit_logs {
  id             String   @id @default(cuid())
  actor_user_id  String
  actor_role     String?
  action         String
  entity_type    String
  entity_id      String?
  company_id     String?
  branch_id      String?
  old_value      Json?
  new_value      Json?
  ip_address     String?
  user_agent     String?
  session_id     String?
  correlation_id String?
  request_path   String?
  request_method String?
  metadata       Json?
  created_at     DateTime @default(now())

  actor users @relation("AuditActor", fields: [actor_user_id], references: [id])

  @@index([actor_user_id])
  @@index([action])
  @@index([entity_type, entity_id])
  @@index([company_id])
  @@index([branch_id])
  @@index([created_at])
}

model analytics_events {
  id              String   @id @default(cuid())
  event_name      String
  event_category  String
  user_id         String?
  anonymous_id    String?
  company_id      String?
  branch_id       String?
  professional_id String?
  service_id      String?
  appointment_id  String?
  properties      Json?
  latitude        Float?
  longitude       Float?
  screen_name     String?
  referrer        String?
  utm_source      String?
  utm_medium      String?
  utm_campaign    String?
  utm_content     String?
  session_id      String?
  device_type     String?
  os_name         String?
  app_version     String?
  client_ip       String?
  created_at      DateTime @default(now())

  @@index([event_name])
  @@index([event_category])
  @@index([user_id])
  @@index([company_id])
  @@index([created_at])
  @@index([event_name, created_at])
}

model daily_analytics_snapshots {
  id                    String   @id @default(cuid())
  snapshot_date         DateTime
  company_id            String
  branch_id             String?
  professional_id       String?
  metric_key            String
  metric_value          Float
  metric_label          String?
  category              String
  currency_code         String?
  comparison_date_value Float?
  trend_direction       String?
  trend_percent         Float?
  created_at            DateTime @default(now())

  @@unique([snapshot_date, company_id, branch_id, professional_id, metric_key])
  @@index([snapshot_date])
  @@index([company_id])
  @@index([branch_id])
  @@index([professional_id])
  @@index([metric_key])
}

// ============================================================
// MEDIA
// ============================================================

model media {
  id                 String    @id @default(cuid())
  uploader_user_id   String
  company_id         String?
  branch_id          String?
  original_file_name String
  stored_file_name   String
  storage_key        String
  storage_bucket     String
  storage_provider   String    @default("minio")
  mime_category      String
  mime_type          String
  size_bytes         Int
  width_pixels       Int?
  height_pixels      Int?
  duration_seconds   Float?
  blurhash           String?
  dominant_color_hex String?
  variants           Json?
  alt_text           String?
  caption            String?
  tags               String[]  @default([])
  checksum_sha256    String?
  is_public          Boolean   @default(true)
  license_type       String?
  copyright_holder   String?
  status             String    @default("uploaded")
  processed_at       DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  resource_links resource_media[]

  @@unique([storage_bucket, storage_key])
  @@index([uploader_user_id])
  @@index([company_id])
  @@index([branch_id])
  @@index([mime_category])
  @@index([storage_bucket, storage_key])
  @@index([status])
  @@index([created_at])
  @@index([is_public])
}

// ============================================================
// AUTH TOKENS & VERIFICATION
// ============================================================

model password_reset_tokens {
  id         String    @id @default(cuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  ip_address String?
  user_agent String?
  created_at DateTime  @default(now())

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model email_verification_tokens {
  id          String    @id @default(cuid())
  user_id     String
  email       String
  token_hash  String    @unique
  expires_at  DateTime
  verified_at DateTime?
  created_at  DateTime  @default(now())

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model phone_otp_tokens {
  id            String    @id @default(cuid())
  user_id       String?
  phone         String
  code_hash     String
  purpose       String    @default("verify")
  expires_at    DateTime
  verified_at   DateTime?
  attempt_count Int       @default(0)
  send_count    Int       @default(1)
  ip_address    String?
  created_at    DateTime  @default(now())

  user users? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([phone])
  @@index([purpose])
  @@index([expires_at])
}

// ============================================================
// MISSING §203 MODELS + MODERATION SUPPORT TABLES (Task 1 T1.2)
// ============================================================

model resource_media {
  id          String   @id @default(cuid())
  resource_id String
  media_id    String
  sort_order  Int      @default(0)
  caption     String?
  created_at  DateTime @default(now())

  resource resources @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  media    media     @relation(fields: [media_id], references: [id], onDelete: Cascade)

  @@unique([resource_id, media_id, sort_order])
  @@index([resource_id])
  @@index([media_id])
}

model customer_preferred_resources {
  id          String   @id @default(cuid())
  customer_id String
  resource_id String
  rank_order  Int      @default(0)
  note        String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  customer customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  resource resources @relation(fields: [resource_id], references: [id], onDelete: Cascade)

  @@unique([customer_id, resource_id])
  @@index([customer_id])
  @@index([resource_id])
}

model user_strikes {
  id            String    @id @default(cuid())
  user_id       String
  severity      String    @default("warning")
  reason_type   String
  reason_text   String?
  report_id     String?
  created_by_id String?
  expires_at    DateTime?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  user users @relation("UserStrike", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([is_active])
  @@index([severity])
  @@index([expires_at])
}

model moderation_appeals {
  id                 String    @id @default(cuid())
  target_type        String
  target_id          String
  reporter_user_id   String
  strike_id          String?
  reason_reversal    String
  evidence_media_ids String[]  @default([])
  status             String    @default("pending")
  reviewed_by_id     String?
  reviewed_at        DateTime?
  resolution         String?
  resolution_notes   String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  @@index([target_type, target_id])
  @@index([reporter_user_id])
  @@index([status])
  @@index([created_at])
}

model country_taxes {
  id                  String    @id @default(cuid())
  country_id          String
  name                String
  tax_code            String?
  tax_type            String    @default("vat")
  rate_percent        Float
  applies_to_services Boolean   @default(true)
  applies_to_products Boolean   @default(true)
  effective_from      DateTime?
  effective_to        DateTime?
  is_default          Boolean   @default(false)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  country countries @relation(fields: [country_id], references: [id], onDelete: Cascade)

  @@index([country_id])
  @@index([tax_type])
  @@index([is_default])
}

model bank_accounts {
  id                  String   @id @default(cuid())
  owner_type          String
  owner_id            String
  bank_name           String?
  account_number      String?
  account_holder      String?
  routing_number      String?
  iban                String?
  swift_bic           String?
  currency_code       String
  is_verified         Boolean  @default(false)
  verification_doc_id String?
  payout_enabled      Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@index([owner_type, owner_id])
  @@index([currency_code])
  @@index([is_verified])
  @@index([payout_enabled])
}
