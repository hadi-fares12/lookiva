model promotions {
  id                        String    @id @default(cuid())
  company_id                String
  branch_id                 String?
  code                      String?
  name                      String
  description               String?
  cover_media_id            String?
  promotion_type            String
  value_percent             Float?
  value_fixed               Float?
  minimum_order_amount      Float?
  maximum_discount          Float?
  eligible_category_ids     String[]  @default([])
  eligible_service_ids      String[]  @default([])
  eligible_professional_ids String[]  @default([])
  new_customers_only        Boolean   @default(false)
  first_visit_only          Boolean   @default(false)
  weekday_only              Int[]     @default([])
  happy_hour_start          String?
  happy_hour_end            String?
  is_active                 Boolean   @default(true)
  is_public                 Boolean   @default(true)
  starts_at                 DateTime
  ends_at                   DateTime?
  usage_limit               Int?
  usage_count               Int       @default(0)
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  company      companies         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch       branches?         @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  rules        promotion_rules[]
  coupon_usage coupon_usage[]
  coupons      coupons[]

  @@index([company_id])
  @@index([branch_id])
  @@index([code])
  @@index([is_active])
  @@index([starts_at, ends_at])
}

model promotion_rules {
  id           String   @id @default(cuid())
  promotion_id String
  rule_type    String
  rule_json    Json
  sort_order   Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  promotion promotions @relation(fields: [promotion_id], references: [id], onDelete: Cascade)

  @@index([promotion_id])
}

model coupons {
  id                   String    @id @default(cuid())
  company_id           String
  promotion_id         String?
  code                 String    @unique
  name                 String
  description          String?
  discount_type        String
  discount_percent     Float?
  discount_fixed       Float?
  minimum_order_amount Float?
  is_single_use        Boolean   @default(true)
  is_per_user          Boolean   @default(false)
  max_uses_total       Int?
  max_uses_per_user    Int?
  is_active            Boolean   @default(true)
  valid_from           DateTime
  valid_until          DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  company   companies      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  promotion promotions?    @relation(fields: [promotion_id], references: [id], onDelete: SetNull)
  usage     coupon_usage[]

  @@index([company_id])
  @@index([code])
  @@index([is_active])
  @@index([valid_from, valid_until])
}

model coupon_usage {
  id           String   @id @default(cuid())
  coupon_id    String
  user_id      String
  company_id   String
  promotion_id String?
  order_id     String?
  amount_saved Float
  used_at      DateTime @default(now())
  created_at   DateTime @default(now())

  coupon    coupons     @relation(fields: [coupon_id], references: [id])
  user      users       @relation(fields: [user_id], references: [id])
  company   companies   @relation(fields: [company_id], references: [id])
  promotion promotions? @relation(fields: [promotion_id], references: [id], onDelete: SetNull)

  @@index([coupon_id])
  @@index([user_id])
  @@index([company_id])
}

model packages {
  id                   String   @id @default(cuid())
  company_id           String
  name                 String
  description          String?
  cover_media_id       String?
  category_id          String?
  service_ids          String[]
  total_sessions_count Int
  validity_days        Int?
  price                Float
  currency_code        String
  discount_percent     Float?
  discount_fixed       Float?
  is_active            Boolean  @default(true)
  is_featured          Boolean  @default(false)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  company   companies           @relation(fields: [company_id], references: [id], onDelete: Cascade)
  purchases package_purchases[]

  @@index([company_id])
  @@index([is_active])
}

model package_purchases {
  id                 String    @id @default(cuid())
  package_id         String
  customer_id        String
  payment_id         String?
  sessions_purchased Int
  sessions_remaining Int
  price_paid         Float
  currency_code      String
  purchased_at       DateTime  @default(now())
  expires_at         DateTime?
  status             String    @default("active")
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  package  packages        @relation(fields: [package_id], references: [id])
  customer customers       @relation(fields: [customer_id], references: [id])
  usage    package_usage[]

  @@index([package_id])
  @@index([customer_id])
  @@index([status])
}

model package_usage {
  id                  String   @id @default(cuid())
  package_purchase_id String
  appointment_id      String?
  service_id          String
  professional_id     String?
  sessions_used       Int      @default(1)
  used_at             DateTime @default(now())
  created_at          DateTime @default(now())

  package_purchase package_purchases @relation(fields: [package_purchase_id], references: [id], onDelete: Cascade)
  appointment      appointments?     @relation(fields: [appointment_id], references: [id], onDelete: SetNull)
  service          services          @relation(fields: [service_id], references: [id])

  @@index([package_purchase_id])
  @@index([appointment_id])
}

model memberships {
  id                String   @id @default(cuid())
  company_id        String
  name              String
  description       String?
  cover_media_id    String?
  price_monthly     Float
  price_yearly      Float
  currency_code     String
  trial_days        Int      @default(0)
  included_services Json?
  discount_percent  Float?
  features          Json?
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  company       companies                  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  subscriptions membership_subscriptions[]

  @@index([company_id])
  @@index([is_active])
}

model membership_subscriptions {
  id                 String    @id @default(cuid())
  membership_id      String
  customer_id        String
  payment_method_id  String?
  billing_cycle      String
  price_per_cycle    Float
  currency_code      String
  status             String    @default("active")
  started_at         DateTime  @default(now())
  current_period_end DateTime?
  ends_at            DateTime?
  cancelled_at       DateTime?
  trial_end_at       DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  membership memberships @relation(fields: [membership_id], references: [id])
  customer   customers   @relation(fields: [customer_id], references: [id])

  @@index([membership_id])
  @@index([customer_id])
  @@index([status])
}

model gift_cards {
  id              String    @id @default(cuid())
  company_id      String?
  code            String    @unique
  recipient_name  String?
  recipient_email String?
  recipient_phone String?
  sender_name     String?
  message         String?
  cover_media_id  String?
  initial_amount  Float
  currency_code   String
  expires_at      DateTime?
  is_active       Boolean   @default(true)
  purchased_at    DateTime  @default(now())
  purchased_by_id String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  company companies?         @relation(fields: [company_id], references: [id], onDelete: SetNull)
