  @@index([company_id])
  @@index([branch_id])
  @@index([customer_id])
  @@index([customer_user_id])
  @@index([status])
  @@index([starts_at, ends_at])
  @@index([starts_at])
  @@index([created_at])
  @@index([is_walk_in])
  @@index([source])
}

model appointment_participants {
