  company_id             String
  appointment_id         String?
  consent_type           String
  allowed_usage          String[]
  media_ids              String[]  @default([])
  expires_at             DateTime?
  signed_at              DateTime
  revoked_at             DateTime?
  customer_signature_url String?
  witness_name           String?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

