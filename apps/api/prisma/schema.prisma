  @@index([queue_id])
  @@index([customer_id])
  @@index([status])
  @@index([joined_at])
  @@index([position])
}

// ============================================================
// PAYMENTS & FINANCE
// ============================================================

model payments {
  id                      String    @id @default(cuid())
  company_id              String
  appointment_id          String?
  customer_id             String
  payment_method          String
  currency_code           String
  amount                  Float
  tip_amount              Float?
  deposit_amount          Float?
  reference_code          String?
  external_transaction_id String?
  status                  String    @default("pending")
  paid_at                 DateTime?
  captured_at             DateTime?
  refunded_at             DateTime?
  failure_reason          String?
  gateway_response        Json?
  cash_session_id         String?
  processed_by_user_id    String?
  notes                   String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  company        companies              @relation(fields: [company_id], references: [id])
  appointment    appointments?          @relation(fields: [appointment_id], references: [id], onDelete: SetNull)
  customer       customers              @relation(fields: [customer_id], references: [id])
  transactions   payment_transactions[]
  refunds        refunds[]
  ledger_entries financial_ledger[]
  commissions    commissions[]
  cash_session   cash_sessions?         @relation(fields: [cash_session_id], references: [id], onDelete: SetNull)
  wallet_ledger  wallet_ledger[]

  @@index([company_id])
  @@index([appointment_id])
  @@index([customer_id])
  @@index([status])
  @@index([payment_method])
  @@index([paid_at])
  @@index([reference_code])
  @@index([external_transaction_id])
}

model payment_transactions {
  id                       String    @id @default(cuid())
  payment_id               String
  transaction_type         String
  gateway                  String
  amount                   Float
  currency_code            String
  external_reference       String?
  status                   String
  gateway_response_code    String?
  gateway_response_message String?
  raw_response             Json?
  processed_at             DateTime?
  created_at               DateTime  @default(now())

  payment payments @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([payment_id])
  @@index([status])
  @@index([processed_at])
  @@index([external_reference])
}

model refunds {
  id                   String    @id @default(cuid())
  payment_id           String
  company_id           String
  customer_id          String
  amount               Float
  currency_code        String
  reason               String?
  refund_method        String
  status               String    @default("pending")
  external_reference   String?
  processed_at         DateTime?
  processed_by_user_id String?
  notes                String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  payment payments @relation(fields: [payment_id], references: [id])

  @@index([payment_id])
  @@index([company_id])
  @@index([customer_id])
  @@index([status])
}

model financial_ledger {
  id               String   @id @default(cuid())
  company_id       String
  payment_id       String?
  appointment_id   String?
  entry_type       String
  debit_amount     Float    @default(0)
  credit_amount    Float    @default(0)
  currency_code    String
  exchange_rate_id String?
  category         String
  subcategory      String?
  description      String?
  reference_id     String?
  reference_type   String?
  transaction_date DateTime
  created_by_id    String?
  created_at       DateTime @default(now())

  payment       payments?                @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  exchange_rate exchange_rate_snapshots? @relation(fields: [exchange_rate_id], references: [id], onDelete: SetNull)

  @@index([company_id])
  @@index([payment_id])
  @@index([appointment_id])
  @@index([entry_type])
  @@index([transaction_date])
  @@index([category])
  @@index([reference_id, reference_type])
}

model cash_sessions {
  id                String    @id @default(cuid())
  branch_id         String
  opened_by_user_id String
  closed_by_user_id String?
  opening_cash      Float
  closing_cash      Float?
  expected_cash     Float?
  difference_amount Float?
  difference_note   String?
  opened_at         DateTime  @default(now())
  closed_at         DateTime?
  status            String    @default("open")
  notes             String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  branch    branches         @relation(fields: [branch_id], references: [id])
  movements cash_movements[]
  payments  payments[]

  @@index([branch_id])
  @@index([status])
  @@index([opened_at])
  @@index([opened_by_user_id])
}

model cash_movements {
  id              String   @id @default(cuid())
  cash_session_id String
  movement_type   String
  amount          Float
  currency_code   String
  reason          String?
  reference_id    String?
  created_by_id   String?
  created_at      DateTime @default(now())

  cash_session cash_sessions @relation(fields: [cash_session_id], references: [id], onDelete: Cascade)

  @@index([cash_session_id])
  @@index([movement_type])
}

model exchange_rate_snapshots {
  id              String    @id @default(cuid())
  base_currency   String
  target_currency String
  rate            Float
  source          String?
  effective_from  DateTime
  effective_to    DateTime?
  is_current      Boolean   @default(false)
  created_at      DateTime  @default(now())

  ledger_entries financial_ledger[]

  @@unique([base_currency, target_currency, effective_from])
  @@index([base_currency, target_currency])
  @@index([effective_from])
  @@index([is_current])
}

model commissions {
  id                 String    @id @default(cuid())
  company_id         String
  professional_id    String?
  appointment_id     String?
  payment_id         String?
  rule_id            String?
  commission_type    String
  base_amount        Float
  commission_percent Float?
  commission_fixed   Float?
  commission_amount  Float
  currency_code      String
  status             String    @default("pending")
  payout_id          String?
  calculated_at      DateTime  @default(now())
  paid_at            DateTime?
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  company      companies                   @relation(fields: [company_id], references: [id])
  professional professionals?              @relation(fields: [professional_id], references: [id], onDelete: SetNull)
  payment      payments?                   @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  rule         commission_rules?           @relation(fields: [rule_id], references: [id], onDelete: SetNull)
  payout       professional_payouts?       @relation(fields: [payout_id], references: [id], onDelete: SetNull)
  payout_items professional_payout_items[]

  @@index([company_id])
  @@index([professional_id])
  @@index([appointment_id])
  @@index([payment_id])
  @@index([status])
  @@index([calculated_at])
}

model professional_payouts {
  id                   String    @id @default(cuid())
  company_id           String
  professional_id      String
  payout_period_start  DateTime
  payout_period_end    DateTime
  total_commission     Float
  total_tips           Float
  total_adjustments    Float     @default(0)
  currency_code        String
  gross_amount         Float
  net_amount           Float
  status               String    @default("pending")
  paid_at              DateTime?
  payment_method       String?
  reference_code       String?
  processed_by_user_id String?
  notes                String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  professional professionals               @relation(fields: [professional_id], references: [id])
  items        professional_payout_items[]
  commissions  commissions[]

  @@index([company_id])
  @@index([professional_id])
  @@index([status])
  @@index([payout_period_start, payout_period_end])
}

model professional_payout_items {
  id            String   @id @default(cuid())
  payout_id     String
  commission_id String?
  item_type     String
  description   String
  amount        Float
  currency_code String
  reference_id  String?
  created_at    DateTime @default(now())

  payout     professional_payouts @relation(fields: [payout_id], references: [id], onDelete: Cascade)
  commission commissions?         @relation(fields: [commission_id], references: [id], onDelete: SetNull)

  @@index([payout_id])
}

model wallets {
  id                  String    @id @default(cuid())
  customer_id         String    @unique
  balance_cents       Int       @default(0)
  currency_code       String
  is_active           Boolean   @default(true)
  last_transaction_at DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  customer         customers          @relation(fields: [customer_id], references: [id])
  ledger           wallet_ledger[]
  gift_card_ledger gift_card_ledger[]

  @@index([is_active])
}

model wallet_ledger {
  id                  String   @id @default(cuid())
  wallet_id           String
  payment_id          String?
  transaction_type    String
  amount_cents        Int
  balance_after_cents Int
  currency_code       String
  description         String?
  reference_id        String?
  reference_type      String?
  created_at          DateTime @default(now())

  wallet  wallets   @relation(fields: [wallet_id], references: [id], onDelete: Cascade)
  payment payments? @relation(fields: [payment_id], references: [id], onDelete: SetNull)

  @@index([wallet_id])
  @@index([transaction_type])
  @@index([created_at])
}

// ============================================================
// REVIEWS
// ============================================================

model reviews {
  id                  String    @id @default(cuid())
  author_user_id      String
  company_id          String
  branch_id           String?
  service_id          String?
  professional_id     String?
  appointment_id      String?
  title               String?
  body                String?
  overall_rating      Float
  dimension_ratings   Json?
  media_ids           String[]  @default([])
  response_body       String?
  response_by_user_id String?
  response_at         DateTime?
  helpful_count       Int       @default(0)
  reported_count      Int       @default(0)
  is_verified         Boolean   @default(false)
  is_featured         Boolean   @default(false)
  is_anonymous        Boolean   @default(false)
  status              String    @default("published")
  published_at        DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  author_user  users            @relation("ReviewAuthor", fields: [author_user_id], references: [id])
  company      companies        @relation(fields: [company_id], references: [id])
  professional professionals?   @relation(fields: [professional_id], references: [id], onDelete: SetNull)
  service      services?        @relation(fields: [service_id], references: [id], onDelete: SetNull)
  branch       branches?        @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  appointment  appointments?    @relation(fields: [appointment_id], references: [id], onDelete: SetNull)
  ratings      review_ratings[]
  media_list   review_media[]
  reports      review_reports[]
  customers    customers?       @relation(fields: [customersId], references: [id])
  customersId  String?

  @@index([author_user_id])
  @@index([company_id])
  @@index([professional_id])
  @@index([service_id])
  @@index([branch_id])
  @@index([appointment_id])
  @@index([overall_rating])
  @@index([is_verified])
  @@index([status])
  @@index([created_at])
  @@index([helpful_count])
}

model review_ratings {
  id         String   @id @default(cuid())
  review_id  String
  dimension  String
  rating     Float
  created_at DateTime @default(now())

  review reviews @relation(fields: [review_id], references: [id], onDelete: Cascade)

  @@unique([review_id, dimension])
  @@index([review_id])
  @@index([dimension])
}

model review_media {
  id         String   @id @default(cuid())
  review_id  String
  media_id   String
  media_type String
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  review reviews @relation(fields: [review_id], references: [id], onDelete: Cascade)

  @@index([review_id])
  @@index([sort_order])
}

model review_reports {
  id               String    @id @default(cuid())
  review_id        String
  reporter_user_id String
  reason           String
  details          String?
  status           String    @default("pending")
  reviewed_by_id   String?
  reviewed_at      DateTime?
  action_taken     String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  review reviews @relation(fields: [review_id], references: [id], onDelete: Cascade)

  @@index([review_id])
  @@index([reporter_user_id])
  @@index([status])
}

// ============================================================
// SOCIAL: POSTS, LIKES, COMMENTS, FOLLOWS, FAVORITES, COLLECTIONS
// ============================================================

model posts {
  id                 String    @id @default(cuid())
  author_user_id     String
  author_role        String
  company_id         String?
  branch_id          String?
  professional_id    String?
  title              String?
  slug               String?
  body_plain         String?
  body_html          String?
  cover_media_id     String?
  media_ids          String[]  @default([])
  tags               String[]  @default([])
  service_ids        String[]  @default([])
  category_ids       String[]  @default([])
  is_promotion       Boolean   @default(false)
  promotion_start_at DateTime?
  promotion_end_at   DateTime?
  view_count         Int       @default(0)
  like_count         Int       @default(0)
  comment_count      Int       @default(0)
  share_count        Int       @default(0)
  bookmark_count     Int       @default(0)
  status             String    @default("published")
  scheduled_at       DateTime?
  published_at       DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?

  author       users              @relation("PostAuthor", fields: [author_user_id], references: [id])
  company      companies?         @relation(fields: [company_id], references: [id], onDelete: SetNull)
  branch       branches?          @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  professional professionals?     @relation(fields: [professional_id], references: [id], onDelete: SetNull)
  media_list   post_media[]
  services     post_services[]
  likes        likes[]
  comments     comments[]
  favorites    favorites[]
  collections  collection_items[]

  @@index([author_user_id])
  @@index([author_role])
  @@index([company_id])
  @@index([professional_id])
  @@index([branch_id])
  @@index([status])
  @@index([published_at])
  @@index([created_at])
  @@index([like_count])
  @@index([view_count])
  @@index([slug])
}

model post_media {
  id         String   @id @default(cuid())
  post_id    String
  media_id   String
  media_type String
  sort_order Int      @default(0)
  caption    String?
  created_at DateTime @default(now())

  post posts @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([post_id])
  @@index([sort_order])
}

model post_services {
  id          String   @id @default(cuid())
  post_id     String
  service_id  String
  category_id String?
  is_primary  Boolean  @default(false)
  created_at  DateTime @default(now())

  post     posts               @relation(fields: [post_id], references: [id], onDelete: Cascade)
  service  services            @relation(fields: [service_id], references: [id], onDelete: Cascade)
  category service_categories? @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@unique([post_id, service_id])
  @@index([service_id])
}

model likes {
  id         String   @id @default(cuid())
  user_id    String
  post_id    String
  created_at DateTime @default(now())

  user        users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post        posts      @relation(fields: [post_id], references: [id], onDelete: Cascade)
  customers   customers? @relation(fields: [customersId], references: [id])
  customersId String?

  @@unique([user_id, post_id])
  @@index([post_id])
}

model comments {
  id                String    @id @default(cuid())
  user_id           String
  post_id           String
  parent_comment_id String?
  body              String
  like_count        Int       @default(0)
  reported_count    Int       @default(0)
  status            String    @default("published")
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?

  user        users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post        posts      @relation(fields: [post_id], references: [id], onDelete: Cascade)
  parent      comments?  @relation("CommentTree", fields: [parent_comment_id], references: [id])
  children    comments[] @relation("CommentTree")
  customers   customers? @relation(fields: [customersId], references: [id])
  customersId String?

  @@index([user_id])
  @@index([post_id])
  @@index([parent_comment_id])
  @@index([status])
  @@index([created_at])
}

model follows {
  id               String   @id @default(cuid())
  follower_user_id String
  target_type      String
  target_id        String
  company_id       String?
  professional_id  String?
  created_at       DateTime @default(now())

  follower     users          @relation("Follower", fields: [follower_user_id], references: [id], onDelete: Cascade)
  company      companies?     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  professional professionals? @relation(fields: [professional_id], references: [id], onDelete: Cascade)
  customers    customers?     @relation(fields: [customersId], references: [id])
  customersId  String?

  @@unique([follower_user_id, target_type, target_id])
  @@index([follower_user_id])
  @@index([company_id])
  @@index([professional_id])
  @@index([target_type, target_id])
}

model favorites {
  id              String   @id @default(cuid())
  user_id         String
  favorite_type   String
  entity_id       String
  company_id      String?
  branch_id       String?
  service_id      String?
  professional_id String?
  post_id         String?
  created_at      DateTime @default(now())

  user         users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company      companies?     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch       branches?      @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  service      services?      @relation(fields: [service_id], references: [id], onDelete: Cascade)
  professional professionals? @relation(fields: [professional_id], references: [id], onDelete: Cascade)
  post         posts?         @relation(fields: [post_id], references: [id], onDelete: Cascade)
  customers    customers?     @relation(fields: [customersId], references: [id])
  customersId  String?

  @@unique([user_id, favorite_type, entity_id])
  @@index([user_id])
  @@index([favorite_type])
  @@index([company_id])
  @@index([service_id])
  @@index([professional_id])
  @@index([post_id])
}

model collections {
  id             String   @id @default(cuid())
  user_id        String
  name           String
  description    String?
  cover_media_id String?
  is_public      Boolean  @default(false)
  item_count     Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

