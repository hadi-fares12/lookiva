// APPOINTMENTS
// ============================================================

model appointments {
  id                      String    @id @default(cuid())
  company_id              String
  branch_id               String
  customer_id             String?
  customer_user_id        String?
  contact_name            String?
  contact_phone           String?
  contact_email           String?
  status                  String    @default("pending")
  starts_at               DateTime
  ends_at                 DateTime
  duration_minutes        Int
  guest_count             Int       @default(1)
  notes_customer          String?
  notes_staff             String?
  notes_private           String?
  is_walk_in              Boolean   @default(false)
  is_home_service         Boolean   @default(false)
  home_service_address    String?
  home_service_latitude   Float?
  home_service_longitude  Float?
  arrival_latitude        Float?
  arrival_longitude       Float?
  checked_in_at           DateTime?
  started_at              DateTime?
  completed_at            DateTime?
  cancelled_at            DateTime?
  cancelled_by_user_id    String?
  cancellation_reason     String?
  cancellation_fee_amount Float?
  cancellation_fee_paid   Boolean   @default(false)
  no_show_at              DateTime?
  rescheduled_from_id     String?
  rescheduled_to_id       String?
  queue_entry_id          String?
  source                  String    @default("direct")
  referral_code_used      String?
  created_by_user_id      String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  company                companies                    @relation(fields: [company_id], references: [id])
  branch                 branches                     @relation(fields: [branch_id], references: [id])
  customer               customers?                   @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  participants           appointment_participants[]
  services               appointment_services[]
  resources              appointment_resources[]
  holds                  appointment_holds[]
  status_history         appointment_status_history[]
  notes_list             appointment_notes[]
  media                  appointment_media[]
  booking_snapshot       booking_snapshots?
  financial_snapshot     booking_financial_snapshots?
