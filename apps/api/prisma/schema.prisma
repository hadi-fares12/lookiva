  @@index([company_id])
  @@index([appointment_id])
}

// ============================================================
// CONVERSATIONS & MESSAGES
// ============================================================

model conversations {
  id              String    @id @default(cuid())
  company_id      String?
  appointment_id  String?
  last_message_id String?
  last_message_at DateTime?
  unread_count    Json?
  is_archived     Boolean   @default(false)
  type            String    @default("direct")
  metadata        Json?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  members  conversation_members[]
  messages messages[]

  @@index([company_id])
  @@index([appointment_id])
  @@index([last_message_at])
  @@index([type])
}

model conversation_members {
  id                   String    @id @default(cuid())
  conversation_id      String
  user_id              String
  customer_id          String?
  joined_at            DateTime  @default(now())
  left_at              DateTime?
  last_read_message_id String?
  last_read_at         DateTime?
  is_admin             Boolean   @default(false)
  notifications_muted  Boolean   @default(false)

  conversation conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user         users         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  customer     customers?    @relation(fields: [customer_id], references: [id], onDelete: SetNull)

  @@unique([conversation_id, user_id])
  @@index([conversation_id])
  @@index([user_id])
  @@index([customer_id])
}

model messages {
  id              String    @id @default(cuid())
  conversation_id String
  sender_user_id  String
  message_type    String    @default("text")
  body_plain      String?
  body_html       String?
  reply_to_id     String?
  edited_at       DateTime?
  deleted_at      DateTime?
  metadata        Json?
  created_at      DateTime  @default(now())

  conversation conversations         @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       users                 @relation("MessageSender", fields: [sender_user_id], references: [id])
  attachments  message_attachments[]

  @@index([conversation_id])
  @@index([sender_user_id])
  @@index([created_at])
  @@index([conversation_id, created_at])
}

model message_attachments {
  id         String   @id @default(cuid())
  message_id String
  media_id   String
  media_type String
  file_name  String?
  size_bytes Int?
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  message messages @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@index([message_id])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model notifications {
  id                      String    @id @default(cuid())
  recipient_user_id       String
  notification_type       String
  scope_type              String?
  scope_id                String?
  company_id              String?
  branch_id               String?
