// Prisma Schema for LOOKIVA Platform
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "views"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ============================================================
// USERS & AUTHENTICATION
// ============================================================

model users {
  id                String    @id @default(cuid())
  email             String?   @unique
  email_verified_at DateTime?
  phone             String?   @unique
  phone_verified_at DateTime?
  password_hash     String
  full_name         String
  avatar_media_id   String?
  locale            String    @default("en")
  theme_mode        String    @default("midnight-gold")
  is_active         Boolean   @default(true)
  last_login_at     DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?

  user_profiles                   user_profiles[]
  preferences                     user_preferences[]
  sessions                        sessions[]
  role_scopes                     user_role_scopes[]
  customers                       customers[]
  professionals                   professionals[]
  companies_owned                 companies[]                      @relation("CompanyOwner")
  reviews_written                 reviews[]                        @relation("ReviewAuthor")
  posts                           posts[]                          @relation("PostAuthor")
  likes                           likes[]
  comments                        comments[]
  follows_following               follows[]                        @relation("Follower")
  favorites                       favorites[]
  audit_logs                      audit_logs[]                     @relation("AuditActor")
  notifications                   notifications[]
  conversations                   conversation_members[]
  messages_sent                   messages[]                       @relation("MessageSender")
  referral_accounts               referrals[]                      @relation("ReferralReferrer")
  referral_referred               referrals?                       @relation("ReferralReferred")
  moderation_strikes              user_strikes[]                   @relation("UserStrike")
  notification_preferences        notification_preferences?
  location_preferences            location_preferences?
  nearby_notification_preferences nearby_notification_preferences?
  coupon_usage                    coupon_usage[]
  password_reset_tokens           password_reset_tokens[]
  email_verification_tokens       email_verification_tokens[]
  phone_otp_tokens                phone_otp_tokens[]
  search_history                   search_history[]
  push_devices                     push_devices[]

  @@index([email])
  @@index([phone])
  @@index([is_active])
  @@index([created_at])
}

model user_profiles {
  id                   String    @id @default(cuid())
  user_id              String    @unique
  first_name           String
  last_name            String
  date_of_birth        DateTime?
  gender               String?
  bio                  String?
  website_url          String?
  instagram_handle     String?
  tiktok_handle        String?
  facebook_url         String?
  linkedin_url         String?
  address_line_1       String?
  address_line_2       String?
  postal_code          String?
  city_id              String?
  country_id           String
  currency_code        String?
  notification_token   String?
  completed_onboarding Boolean   @default(false)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  user    users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  country countries @relation("UserProfileCountry", fields: [country_id], references: [id])
  city    cities?   @relation("UserProfileCity", fields: [city_id], references: [id], onDelete: SetNull)

  @@index([country_id])
  @@index([city_id])
}

model user_preferences {
  id                        String   @id @default(cuid())
  user_id                   String   @unique
  email_marketing           Boolean  @default(false)
  email_bookings            Boolean  @default(true)
  email_reviews             Boolean  @default(true)
  push_marketing            Boolean  @default(false)
  push_bookings             Boolean  @default(true)
  push_reviews              Boolean  @default(true)
  push_messages             Boolean  @default(true)
  push_system               Boolean  @default(true)
  sms_bookings              Boolean  @default(false)
  sms_reminders             Boolean  @default(false)
  nearby_enabled            Boolean  @default(false)
  nearby_radius_meters      Int      @default(1000)
  auto_translate            Boolean  @default(false)
  reduced_motion            Boolean  @default(false)
  high_contrast             Boolean  @default(false)
  show_verified_only        Boolean  @default(false)
  default_payment_method_id String?
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model search_history {
  id          String   @id @default(cuid())
  user_id     String
  query_text  String
  entity_type String?
  created_at  DateTime @default(now())

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([query_text])
}

model push_devices {
  id           String   @id @default(cuid())
  user_id      String
  token        String   @unique
  platform     String
  app_type     String   @default("customer")
  device_name  String?
  locale       String?
  is_enabled   Boolean  @default(true)
  last_seen_at DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_enabled])
  @@index([platform])
}

model sessions {
  id                 String    @id @default(cuid())
  user_id            String
  refresh_token_hash String    @unique
  access_token_jti   String    @unique
  user_agent         String?
  ip_address         String?
  country_code       String?
  city               String?
  device_type        String?
  device_name        String?
  family_id          String?
  expires_at         DateTime
  last_active_at     DateTime?
  revoked_at         DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@index([expires_at])
  @@index([revoked_at])
}

// ============================================================
// RBAC - ROLES & PERMISSIONS
// ============================================================

model roles {
  id          String   @id @default(cuid())
  key         String   @unique
  scope_type  String
  name        String
  description String?
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  role_permissions role_permissions[]
  user_scopes      user_role_scopes[]

  @@index([key])
  @@index([scope_type])
}

model permissions {
  id          String   @id @default(cuid())
  key         String   @unique
  scope_type  String
  name        String
  description String?
  group       String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  role_permissions role_permissions[]

  @@index([key])
  @@index([group])
}

model role_permissions {
  id            String   @id @default(cuid())
  role_id       String
  permission_id String
  created_at    DateTime @default(now())

  role       roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([permission_id])
}

model user_role_scopes {
  id                 String    @id @default(cuid())
  user_id            String
  role_id            String
  role_key           String
  scope_type         String
  scope_id           String?
  company_id         String?
  branch_id          String?
  granted_by_user_id String?
  expires_at         DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  user        users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role        roles      @relation(fields: [role_id], references: [id], onDelete: Cascade)
  companies   companies? @relation(fields: [companiesId], references: [id])
  companiesId String?
  branches    branches?  @relation(fields: [branchesId], references: [id])
  branchesId  String?

  @@unique([user_id, role_id, scope_type, scope_id])
  @@index([user_id])
  @@index([user_id, role_key, scope_type, scope_id])
  @@index([company_id])
  @@index([branch_id])
}

// ============================================================
// GEOGRAPHY
// ============================================================

model countries {
  id              String   @id @default(cuid())
  iso_code        String   @unique
  name            String
  native_name     String?
  dial_code       String
  currency_code   String
  currency_symbol String?
  flag_emoji      String?
  latitude        Float?
  longitude       Float?
  timezones       String[] @default([])
  languages       String[] @default([])
  is_active       Boolean  @default(true)
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  regions       regions[]
  districts     districts[]
  cities        cities[]
  areas         areas[]
  companies     companies[]
  branches      branches[]
  user_profiles user_profiles[] @relation("UserProfileCountry")
  taxes         country_taxes[]

  @@index([iso_code])
  @@index([is_active])
}

model regions {
  id          String   @id @default(cuid())
  country_id  String
  code        String?
  name        String
  native_name String?
  latitude    Float?
  longitude   Float?
  is_active   Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  country   countries   @relation(fields: [country_id], references: [id], onDelete: Cascade)
  districts districts[]
  cities    cities[]
  areas     areas[]
  branches  branches[]

  @@unique([country_id, code])
  @@index([country_id])
  @@index([is_active])
}

model districts {
  id          String   @id @default(cuid())
  region_id   String
  country_id  String
  code        String?
  name        String
  native_name String?
  latitude    Float?
  longitude   Float?
  is_active   Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  country  countries  @relation(fields: [country_id], references: [id], onDelete: Cascade)
  region   regions    @relation(fields: [region_id], references: [id], onDelete: Cascade)
  cities   cities[]
  areas    areas[]
  branches branches[]

  @@unique([region_id, code])
  @@index([region_id])
  @@index([country_id])
  @@index([is_active])
}

model cities {
  id          String   @id @default(cuid())
  district_id String?
  region_id   String?
  country_id  String
  code        String?
  name        String
  native_name String?
  latitude    Float?
  longitude   Float?
  timezone    String?
  is_active   Boolean  @default(true)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  country       countries       @relation(fields: [country_id], references: [id], onDelete: Cascade)
  region        regions?        @relation(fields: [region_id], references: [id], onDelete: SetNull)
  district      districts?      @relation(fields: [district_id], references: [id], onDelete: SetNull)
  areas         areas[]
  branches      branches[]
  user_profiles user_profiles[] @relation("UserProfileCity")

  @@index([country_id])
  @@index([region_id])
  @@index([district_id])
  @@index([name])
  @@index([is_active])
}

model areas {
  id            String   @id @default(cuid())
  city_id       String
  country_id    String
  code          String?
  name          String
  native_name   String?
  latitude      Float?
  longitude     Float?
  radius_meters Int?
  postal_codes  String[] @default([])
  is_active     Boolean  @default(true)
  sort_order    Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  city        cities     @relation(fields: [city_id], references: [id], onDelete: Cascade)
  country     countries  @relation(fields: [country_id], references: [id], onDelete: Cascade)
  branches    branches[]
  regions     regions?   @relation(fields: [regionsId], references: [id])
  regionsId   String?
  districts   districts? @relation(fields: [districtsId], references: [id])
  districtsId String?

  @@index([city_id])
  @@index([country_id])
  @@index([name])
  @@index([is_active])
}

model languages {
  id          String   @id @default(cuid())
  iso_code    String   @unique
  iso3_code   String?
  name        String
  native_name String
  direction   String   @default("ltr")
  flag_emoji  String?
  is_active   Boolean  @default(true)
  is_default  Boolean  @default(false)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model currencies {
  id             String   @id @default(cuid())
  iso_code       String   @unique
  numeric_code   String?
  name           String
  symbol         String
  native_symbol  String?
  decimal_digits Int      @default(2)
  rounding       Float    @default(0)
  is_active      Boolean  @default(true)
  is_default     Boolean  @default(false)
  sort_order     Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

// ============================================================
// PLATFORM SETTINGS
// ============================================================

model platform_settings {
  id                         String   @id @default(cuid())
  site_name                  String   @default("LOOKIVA")
  tagline                    String?
  logo_media_id              String?
  favicon_media_id           String?
  default_locale             String   @default("en")
  default_theme              String   @default("midnight-gold")
  default_currency_code      String   @default("USD")
  default_country_code       String   @default("LB")
  min_booking_notice_minutes Int?
  max_booking_advance_days   Int?
  default_cancellation_hours Int?
  default_deposit_percent    Float?
  maintenance_mode           Boolean  @default(false)
  maintenance_message        String?
  support_email              String   @default("support@lookiva.dev")
  support_phone              String?
  whatsapp_number            String?
  social_links               Json?
  legal_urls                 Json?
  version                    String   @default("1.0.0")
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt
}

model theme_settings {
  id         String   @id @default(cuid())
  key        String   @unique
  name       String
  palette    Json
  is_active  Boolean  @default(true)
  is_default Boolean  @default(false)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model feature_flags {
  id              String    @id @default(cuid())
  key             String    @unique
  name            String
  description     String?
  is_enabled      Boolean   @default(false)
  rollout_percent Int       @default(0)
  user_ids        String[]  @default([])
  country_codes   String[]  @default([])
  environment     String?
  expires_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
}

model remote_config {
  id              String   @id @default(cuid())
  key             String   @unique
  value_json      Json
  value_type      String   @default("string")
  description     String?
  is_public       Boolean  @default(true)
  min_app_version String?
  platforms       String[] @default([])
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

// ============================================================
// COMPANIES & BRANCHES
// ============================================================

model companies {
  id                         String    @id @default(cuid())
  owner_user_id              String
  country_id                 String
  city_id                    String?
  category_ids               String[]
  legal_name                 String?
  display_name               String
  slug                       String    @unique
  description_short          String?
  description_long           String?
  tagline                    String?
  tax_number                 String?
  commercial_register_number String?
  cover_media_id             String?
  logo_media_id              String?
  website_url                String?
  booking_enabled            Boolean   @default(true)
  walk_ins_enabled           Boolean   @default(true)
  online_payments_enabled    Boolean   @default(false)
  min_booking_notice_minutes Int?
  max_booking_advance_days   Int?
  cancellation_policy_hours  Int?
  cancellation_fee_percent   Float?
  no_show_fee_percent        Float?
  deposit_required           Boolean   @default(false)
  deposit_percent            Float?
  auto_confirm_bookings      Boolean   @default(true)
  avg_rating                 Float?
  review_count               Int       @default(0)
  follower_count             Int       @default(0)
  view_count                 Int       @default(0)
  featured_level             Int?
  featured_expires_at        DateTime?
  is_verified                Boolean   @default(false)
  is_active                  Boolean   @default(true)
  verified_at                DateTime?
  published_at               DateTime?
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt
  deleted_at                 DateTime?

  owner_user                users                       @relation("CompanyOwner", fields: [owner_user_id], references: [id])
  country                   countries                   @relation(fields: [country_id], references: [id])
  branches                  branches[]
  professionals             professionals[]
  services                  services[]
  reviews                   reviews[]
  posts                     posts[]
  favorites                 favorites[]
  follows                   follows[]
  settings                  company_settings?
  verification              company_verification?
  user_role_scopes          user_role_scopes[]
  commissions               commissions[]
  subscriptions             subscriptions[]
  resources                 resources[]
  appointments              appointments[]
  appointment_holds         appointment_holds[]
  payments                  payments[]
  business_nearby_campaigns business_nearby_campaigns[]
  promotions                promotions[]
  coupons                   coupons[]
  coupon_usage              coupon_usage[]
  packages                  packages[]
  memberships               memberships[]
  gift_cards                gift_cards[]
  products                  products[]
  consent_forms             consent_forms[]
  commission_rules          commission_rules[]
  disputes                  disputes[]

  @@index([owner_user_id])
  @@index([country_id])
  @@index([city_id])
  @@index([slug])
  @@index([is_verified, is_active])
  @@index([avg_rating])
  @@index([review_count])
  @@index([follower_count])
  @@index([created_at])
  @@index([display_name])
}

model company_settings {
  id                     String   @id @default(cuid())
  company_id             String   @unique
  facilities             String[]
  languages_spoken       String[]
  parking_options        String[]
  accepted_payments      String[]
  policies               Json?
  cancellation_policy    String?
  refund_policy          String?
  privacy_policy         String?
  home_service_enabled   Boolean  @default(false)
  home_service_radius    Int?
  default_tax_percent    Float?
  min_order_amount       Float?
  max_daily_appointments Int?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  company companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
}

model company_verification {
  id                   String    @id @default(cuid())
  company_id           String    @unique
  submitted_by_user_id String
  legal_business_name  String?
  registration_number  String?
  tax_id_number        String?
  owner_full_name      String?
  owner_id_number      String?
  documents            String[]
  notes                String?
  reviewed_by_user_id  String?
  reviewed_at          DateTime?
  rejection_reason     String?
  status               String    @default("pending")
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  company companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
}

model branches {
  id                         String    @id @default(cuid())
  company_id                 String
  manager_user_id            String?
  country_id                 String
  city_id                    String?
  area_id                    String?
  region_id                  String?
  district_id                String?
  reference_code             String?
  name                       String
  slug                       String
  description                String?
  address_line_1             String?
  address_line_2             String?
  postal_code                String?
  latitude                   Float?
  longitude                  Float?
  geohash                    String?
  phone                      String?
  phone_secondary            String?
  email                      String?
  whatsapp                   String?
  facebook_url               String?
  instagram_handle           String?
  cover_media_id             String?
  timezone                   String?
  booking_enabled            Boolean   @default(true)
  walk_ins_enabled           Boolean   @default(true)
  home_service_enabled       Boolean   @default(false)
  home_service_radius_meters Int?
  auto_confirm_bookings      Boolean?
  sort_order                 Int       @default(0)
  is_active                  Boolean   @default(true)
  is_main                    Boolean   @default(false)
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt
  deleted_at                 DateTime?

  company                          companies                          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  country                          countries                          @relation(fields: [country_id], references: [id])
  city                             cities?                            @relation(fields: [city_id], references: [id], onDelete: SetNull)
  area                             areas?                             @relation(fields: [area_id], references: [id], onDelete: SetNull)
  region                           regions?                           @relation(fields: [region_id], references: [id], onDelete: SetNull)
  district                         districts?                         @relation(fields: [district_id], references: [id], onDelete: SetNull)
  location                         branch_locations?
  hours                            branch_hours[]
  exceptions                       branch_exceptions[]
  professional_branches            professional_branches[]
  resources                        resources[]
  appointments                     appointments[]
  queues                           queues[]
  user_role_scopes                 user_role_scopes[]
  professional_schedules           professional_schedules[]
  professional_schedule_exceptions professional_schedule_exceptions[]
  service_branch_settings          service_branch_settings[]
  floor_plans                      floor_plans[]
  appointment_holds                appointment_holds[]
  cash_sessions                    cash_sessions[]
  reviews                          reviews[]
  posts                            posts[]
  favorites                        favorites[]
  business_nearby_campaigns        business_nearby_campaigns[]
  promotions                       promotions[]
  inventory_items                  inventory_items[]
  inventory_movements              inventory_movements[]

  @@unique([company_id, slug])
  @@index([company_id])
  @@index([country_id])
  @@index([city_id])
  @@index([area_id])
  @@index([slug])
  @@index([is_active])
  @@index([latitude, longitude])
}

model branch_locations {
  id         String                                @id @default(cuid())
  branch_id  String                                @unique
  address    String?
  point      Unsupported("geometry(Point, 4326)")?
  floor      String?
  landmark   String?
  created_at DateTime                              @default(now())
  updated_at DateTime                              @updatedAt

  branch branches @relation(fields: [branch_id], references: [id], onDelete: Cascade)
}

model branch_hours {
  id                String   @id @default(cuid())
  branch_id         String
  day_of_week       Int
  is_closed         Boolean  @default(false)
  opens_at          String?
  closes_at         String?
  break_starts_at   String?
  break_ends_at     String?
  slot_size_minutes Int      @default(15)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  branch branches @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@unique([branch_id, day_of_week])
  @@index([branch_id])
}

model branch_exceptions {
  id             String   @id @default(cuid())
  branch_id      String
  exception_date DateTime
  is_closed      Boolean  @default(true)
  opens_at       String?
  closes_at      String?
  reason         String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  branch branches @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@unique([branch_id, exception_date])
  @@index([branch_id])
  @@index([exception_date])
}

// ============================================================
// PROFESSIONALS
// ============================================================

model professionals {
  id                   String    @id @default(cuid())
  user_id              String
  company_id           String
  branch_ids           String[]
  member_number        String?
  display_name         String
  bio                  String?
  avatar_media_id      String?
  cover_media_id       String?
  specialties          String[]  @default([])
  tags                 String[]  @default([])
  years_experience     Int?
  gender_preference    String?
  accepts_walk_ins     Boolean   @default(true)
  accepts_home_service Boolean   @default(false)
  commission_percent   Float?
  avg_rating           Float?
  review_count         Int       @default(0)
  follower_count       Int       @default(0)
  sort_order           Int       @default(0)
  is_verified          Boolean   @default(false)
  is_active            Boolean   @default(true)
  verified_at          DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  deleted_at           DateTime?

  user                 users                              @relation(fields: [user_id], references: [id])
  company              companies                          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  profile              professional_profiles?
  branches             professional_branches[]
  services_links       service_professionals[]
  schedules            professional_schedules[]
  schedule_exceptions  professional_schedule_exceptions[]
  resources_links      professional_resources[]
  reviews              reviews[]
  posts                posts[]
  favorites            favorites[]
  follows              follows[]
  commissions          commissions[]
  payouts              professional_payouts[]
  appointments         appointment_participants[]
  appointment_services appointment_services[]

  @@index([user_id])
  @@index([company_id])
  @@index([is_active])
  @@index([avg_rating])
  @@index([review_count])
  @@index([follower_count])
  @@index([display_name])
}

model professional_profiles {
  id                  String   @id @default(cuid())
  professional_id     String   @unique
  user_id             String
  education           String[] @default([])
  certifications      String[] @default([])
  awards              String[] @default([])
  languages_spoken    String[] @default([])
  portfolio_media_ids String[] @default([])
  reel_media_ids      String[] @default([])
  pricing_notes       String?
  social_links        Json?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  professional professionals @relation(fields: [professional_id], references: [id], onDelete: Cascade)
}

model professional_branches {
  id                 String   @id @default(cuid())
  professional_id    String
  branch_id          String
  is_primary         Boolean  @default(false)
  commission_percent Float?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  professional professionals @relation(fields: [professional_id], references: [id], onDelete: Cascade)
  branch       branches      @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@unique([professional_id, branch_id])
  @@index([branch_id])
}

model service_professionals {
  id              String   @id @default(cuid())
  professional_id String
  service_id      String
  is_primary      Boolean  @default(false)
  custom_price    Float?
  custom_duration Int?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  professional professionals @relation(fields: [professional_id], references: [id], onDelete: Cascade)
  service      services      @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@unique([professional_id, service_id])
  @@index([service_id])
  @@map("professional_services")
}

model professional_schedules {
  id              String    @id @default(cuid())
  professional_id String
  branch_id       String
  day_of_week     Int
  is_off          Boolean   @default(false)
  starts_at       String?
  ends_at         String?
  break_starts_at String?
  break_ends_at   String?
  effective_from  DateTime?
  effective_to    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  professional professionals @relation(fields: [professional_id], references: [id], onDelete: Cascade)
  branch       branches      @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@index([professional_id])
  @@index([branch_id])
}

model professional_schedule_exceptions {
  id              String   @id @default(cuid())
  professional_id String
  branch_id       String?
  exception_date  DateTime
  is_off          Boolean  @default(true)
  starts_at       String?
  ends_at         String?
  reason          String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  professional professionals @relation(fields: [professional_id], references: [id], onDelete: Cascade)
  branch       branches?     @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  @@index([professional_id])
  @@index([exception_date])
}

// ============================================================
// CATEGORIES & SERVICES
// ============================================================

model service_categories {
  id                            String   @id @default(cuid())
  parent_id                     String?
  country_id                    String?
  code                          String?
  slug                          String   @unique
  name                          String
  name_translations             Json?
  description                   String?
  description_translations      Json?
  icon_key                      String?
  cover_media_id                String?
  color                         String?
  home_service_allowed          Boolean  @default(false)
  requires_professional         Boolean  @default(true)
  default_duration_minutes      Int?
  default_buffer_before_minutes Int      @default(0)
  default_buffer_after_minutes  Int      @default(0)
  sort_order                    Int      @default(0)
  is_active                     Boolean  @default(true)
  is_featured                   Boolean  @default(false)
  depth_level                   Int      @default(0)
  created_at                    DateTime @default(now())
  updated_at                    DateTime @updatedAt

  parent               service_categories?         @relation("CategoryTree", fields: [parent_id], references: [id])
  children             service_categories[]        @relation("CategoryTree")
  services             services[]
  posts                post_services[]
  discovery_candidates business_nearby_campaigns[]

  @@index([parent_id])
  @@index([country_id])
  @@index([slug])
  @@index([is_active])
  @@index([sort_order])
  @@index([name])
}

model services {
  id                        String    @id @default(cuid())
  company_id                String
  category_id               String
  branch_ids                String[]
  professional_ids          String[]
  resource_ids              String[]  @default([])
  sku                       String?
  slug                      String
  name                      String
  summary                   String?
  description               String?
  cover_media_id            String?
  gallery_media_ids         String[]  @default([])
  duration_minutes          Int
  buffer_before_minutes     Int       @default(0)
  buffer_after_minutes      Int       @default(0)
  base_price                Float
  currency_code             String
  tax_inclusive             Boolean   @default(true)
  tax_percent               Float?
  discount_percent          Float?
  discount_fixed            Float?
  discount_valid_from       DateTime?
  discount_valid_until      DateTime?
  home_service_allowed      Boolean   @default(false)
  home_service_fee          Float?
  walk_ins_allowed          Boolean   @default(true)
  gender_preference         String?
  max_clients_per_slot      Int       @default(1)
  online_payment_required   Boolean   @default(false)
  deposit_percent           Float?
  cancellation_policy_hours Int?
  cancellation_fee_percent  Float?
  tags                      String[]  @default([])
  avg_rating                Float?
  review_count              Int       @default(0)
  booking_count             Int       @default(0)
  sort_order                Int       @default(0)
  is_active                 Boolean   @default(true)
  is_featured               Boolean   @default(false)
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt
  deleted_at                DateTime?

  company               companies                       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  category              service_categories              @relation(fields: [category_id], references: [id])
  translations          service_translations[]
  branch_settings       service_branch_settings[]
  dependencies          service_dependencies[]          @relation("Dependency")
  dependents            service_dependencies[]          @relation("Dependent")
  stages                service_stages[]
  professionals_links   service_professionals[]
  resource_requirements service_resource_requirements[]
  reviews               reviews[]
  appointments          appointment_services[]
  favorites             favorites[]
  posts                 post_services[]
  package_usage         package_usage[]

  @@unique([company_id, slug])
  @@index([company_id])
  @@index([category_id])
  @@index([slug])
  @@index([is_active])
  @@index([base_price])
  @@index([avg_rating])
  @@index([review_count])
  @@index([booking_count])
  @@index([duration_minutes])
}

model service_translations {
  id          String   @id @default(cuid())
  service_id  String
  locale      String
  name        String
  summary     String?
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  service services @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@unique([service_id, locale])
  @@index([locale])
}

model service_branch_settings {
  id                      String   @id @default(cuid())
  service_id              String
  branch_id               String
  is_enabled              Boolean  @default(true)
  custom_price            Float?
  custom_duration         Int?
  custom_deposit_percent  Float?
  online_payment_required Boolean?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  service services @relation(fields: [service_id], references: [id], onDelete: Cascade)
  branch  branches @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@unique([service_id, branch_id])
  @@index([branch_id])
}

model service_dependencies {
  id              String   @id @default(cuid())
  service_id      String
  prerequisite_id String
  min_gap_minutes Int      @default(0)
  max_gap_minutes Int?
  is_optional     Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  service      services @relation("Dependent", fields: [service_id], references: [id], onDelete: Cascade)
  prerequisite services @relation("Dependency", fields: [prerequisite_id], references: [id])

  @@unique([service_id, prerequisite_id])
  @@index([prerequisite_id])
}

model service_stages {
  id               String   @id @default(cuid())
  service_id       String
  stage_order      Int
  name             String
  description      String?
  duration_minutes Int
  resource_type_id String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  service       services        @relation(fields: [service_id], references: [id], onDelete: Cascade)
  resource_type resource_types? @relation(fields: [resource_type_id], references: [id], onDelete: SetNull)

  @@index([service_id])
  @@index([stage_order])
}

// ============================================================
// RESOURCES
// ============================================================

model resource_types {
  id               String   @id @default(cuid())
  code             String   @unique
  key              String   @unique
  name             String
  description      String?
  icon_key         String?
  default_capacity Int      @default(1)
  requires_booking Boolean  @default(true)
  allow_parallel   Boolean  @default(false)
  sort_order       Int      @default(0)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  resources            resources[]
  service_stages       service_stages[]
  service_resource_req service_resource_requirements[]
}

model resources {
  id                String    @id @default(cuid())
  company_id        String
  branch_id         String?
  resource_type_id  String?
  code              String?
  name              String
  type              String
  description       String?
  icon_key          String?
  media_ids         String[]  @default([])
  quantity          Int       @default(1)
  location_note     String?
  capacity_per_slot Int?
  setup_minutes     Int       @default(0)
  cleanup_minutes   Int       @default(0)
  hourly_cost       Float?
  currency_code     String?
  attributes        Json?
  tags              String[]  @default([])
  sort_order        Int       @default(0)
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?

  company                companies                       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch                 branches?                       @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  resource_type          resource_types?                 @relation(fields: [resource_type_id], references: [id], onDelete: SetNull)
  professionals_links    professional_resources[]
  service_requirements   service_resource_requirements[]
  blocks                 resource_blocks[]
  maintenance            resource_maintenance[]
  floor_plan_items       floor_plan_items[]
  appointments           appointment_resources[]
  preferred_by_customers customer_preferred_resources[]
  media_links            resource_media[]
  resource_attributes    resource_attributes[]

  @@index([company_id])
  @@index([branch_id])
  @@index([resource_type_id])
  @@index([type])
  @@index([is_active])
  @@index([name])
}

model resource_attributes {
  id                 String   @id @default(cuid())
  resource_id        String
  attribute_key      String
  attribute_value    String
  label_translations Json?
  searchable         Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  resource resources @relation(fields: [resource_id], references: [id], onDelete: Cascade)

  @@index([resource_id])
  @@index([attribute_key])
}

model professional_resources {
  id              String   @id @default(cuid())
  professional_id String
  resource_id     String
  is_default      Boolean  @default(false)
  priority        Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  professional professionals @relation(fields: [professional_id], references: [id], onDelete: Cascade)
  resource     resources     @relation(fields: [resource_id], references: [id], onDelete: Cascade)

  @@unique([professional_id, resource_id])
  @@index([resource_id])
}

model service_resource_requirements {
  id                 String   @id @default(cuid())
  service_id         String
  resource_type_id   String?
  resource_id        String?
  quantity_required  Int      @default(1)
  min_quantity       Int      @default(1)
  stage_id           String?
  allow_substitution Boolean  @default(true)
  surcharge_amount   Float?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  service       services        @relation(fields: [service_id], references: [id], onDelete: Cascade)
  resource_type resource_types? @relation(fields: [resource_type_id], references: [id], onDelete: SetNull)
  resource      resources?      @relation(fields: [resource_id], references: [id], onDelete: SetNull)

  @@index([service_id])
  @@index([resource_type_id])
  @@index([resource_id])
}

model resource_blocks {
  id              String   @id @default(cuid())
  resource_id     String
  block_type      String
  starts_at       DateTime
  ends_at         DateTime
  reason          String?
  created_by_id   String?
  is_recurring    Boolean  @default(false)
  recurrence_rule String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  resource resources @relation(fields: [resource_id], references: [id], onDelete: Cascade)

  @@index([resource_id])
  @@index([starts_at, ends_at])
}

model resource_maintenance {
  id               String    @id @default(cuid())
  resource_id      String
  maintenance_type String
