  completed_at     DateTime?
  status           String    @default("scheduled")
  cost_amount      Float?
  currency_code    String?
  notes            String?
  performed_by     String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  resource resources @relation(fields: [resource_id], references: [id], onDelete: Cascade)

  @@index([resource_id])
  @@index([scheduled_at])
  @@index([status])
}

model floor_plans {
  id                  String   @id @default(cuid())
  branch_id           String
  name                String
  description         String?
  width_cm            Int?
  height_cm           Int?
  background_media_id String?
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  branch branches           @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  items  floor_plan_items[]

  @@index([branch_id])
}

model floor_plan_items {
  id            String   @id @default(cuid())
  floor_plan_id String
  resource_id   String?
  item_type     String
  label         String?
  x_position_cm Int
  y_position_cm Int
  width_cm      Int
  height_cm     Int
  rotation_deg  Int      @default(0)
  zone          String?
  color         String?
  sort_order    Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  floor_plan floor_plans @relation(fields: [floor_plan_id], references: [id], onDelete: Cascade)
  resource   resources?  @relation(fields: [resource_id], references: [id], onDelete: SetNull)

  @@index([floor_plan_id])
  @@index([resource_id])
