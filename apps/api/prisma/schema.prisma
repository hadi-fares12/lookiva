  starts_at        DateTime?
  ends_at          DateTime?
  surcharge_amount Float?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  appointment appointments @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  resource    resources    @relation(fields: [resource_id], references: [id])

  @@unique([appointment_id, resource_id, stage_id])
  @@index([appointment_id])
  @@index([resource_id])
}

model appointment_holds {
  id              String    @id @default(cuid())
  appointment_id  String?
  customer_id     String
  company_id      String
  branch_id       String
  professional_id String?
  resource_ids    String[]  @default([])
  service_ids     String[]  @default([])
  hold_token      String    @unique
  expires_at      DateTime
  held_until      DateTime
  starts_at       DateTime?
  ends_at         DateTime?
  status          String    @default("active")
  converted_at    DateTime?
  created_by_ip   String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  appointment appointments? @relation(fields: [appointment_id], references: [id], onDelete: SetNull)
  customer    customers     @relation(fields: [customer_id], references: [id])
  company     companies     @relation(fields: [company_id], references: [id])
  branch      branches      @relation(fields: [branch_id], references: [id])

  @@index([customer_id])
  @@index([company_id])
  @@index([branch_id])
  @@index([status])
  @@index([expires_at])
  @@index([held_until])
}

model appointment_status_history {
  id             String   @id @default(cuid())
  appointment_id String
  old_status     String?
  new_status     String
  changed_by_id  String?
  reason         String?
  notes          String?
  created_at     DateTime @default(now())

  appointment appointments @relation(fields: [appointment_id], references: [id], onDelete: Cascade)

  @@index([appointment_id])
  @@index([new_status])
  @@index([created_at])
}

model appointment_notes {
  id             String   @id @default(cuid())
  appointment_id String
  author_user_id String
  note_text      String
  is_private     Boolean  @default(false)
  is_pinned      Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  appointment appointments @relation(fields: [appointment_id], references: [id], onDelete: Cascade)

  @@index([appointment_id])
  @@index([is_pinned])
}

model appointment_media {
  id             String   @id @default(cuid())
  appointment_id String
  media_id       String
  media_type     String
  is_before      Boolean  @default(false)
  is_after       Boolean  @default(false)
  caption        String?
  uploaded_by_id String?
  created_at     DateTime @default(now())

  appointment appointments @relation(fields: [appointment_id], references: [id], onDelete: Cascade)

  @@index([appointment_id])
  @@index([media_id])
}

model booking_snapshots {
  id                     String   @id @default(cuid())
  appointment_id         String   @unique
  snapshot_version       Int      @default(1)
  services_snapshot      Json
  professionals_snapshot Json
  resources_snapshot     Json
  branches_snapshot      Json
  company_snapshot       Json
  pricing_snapshot       Json
  policies_snapshot      Json
  created_at             DateTime @default(now())

  appointment appointments @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
}

model booking_financial_snapshots {
  id                       String   @id @default(cuid())
  appointment_id           String   @unique
  currency_code            String
  exchange_rate_snapshot   Json?
  services_total           Float
  discount_total           Float
  resource_surcharges      Float
  tax_total                Float
  deposit_percent          Float?
  deposit_amount           Float
  cancellation_fee         Float
  grand_total              Float
  amount_due_now           Float
  amount_due_later         Float
  commission_rule_snapshot Json?
  tax_breakdown            Json?
  created_at               DateTime @default(now())

  appointment appointments @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
}

// ============================================================
// QUEUES
// ============================================================

model queues {
  id                                String   @id @default(cuid())
  branch_id                         String
  name                              String   @default("Default")
  is_active                         Boolean  @default(true)
  estimated_wait_per_person_minutes Int      @default(15)
  max_waiting                       Int
  created_at                        DateTime @default(now())
  updated_at                        DateTime @updatedAt

  branch  branches        @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  entries queue_entries[]

  @@index([branch_id])
  @@index([is_active])
}

model queue_entries {
  id                     String    @id @default(cuid())
  queue_id               String
  appointment_id         String?
  customer_id            String?
  customer_name          String?
  customer_phone         String?
  service_ids            String[]  @default([])
  professional_id        String?
  position               Int
  estimated_wait_minutes Int?
  joined_at              DateTime  @default(now())
  called_at              DateTime?
  served_at              DateTime?
  completed_at           DateTime?
  cancelled_at           DateTime?
  cancellation_reason    String?
  status                 String    @default("waiting")
  notes                  String?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  queue       queues        @relation(fields: [queue_id], references: [id], onDelete: Cascade)
  appointment appointments? @relation(fields: [appointment_id], references: [id], onDelete: SetNull)
